# ---------------------------------------------------------------------------
# eFankatia — variables d'environnement
# Copier ce fichier vers `.env` puis renseigner les valeurs.
# `.env` est gitignoré : ne jamais committer de secrets.
# ---------------------------------------------------------------------------

# --- Développement local ----------------------------------------------------
# Valeurs affichées par `npx supabase status` :
#   VITE_SUPABASE_URL      ← « Project URL »
#   VITE_SUPABASE_ANON_KEY ← « Publishable » (anciennement « anon »)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Seed administrateur ----------------------------------------------------
# Compte ROLE_ADMIN créé (ou mis à jour) par `npm run seed:user:admin-create`.
# Variables serveur uniquement : ne jamais les préfixer par VITE_.
# Le mot de passe doit contenir au moins 8 caractères.
ADMIN_EMAIL=admin@efankatia.local
ADMIN_PASSWORD="ChangeMe123!"

# --- Production (Vercel) ----------------------------------------------------
# Après `npx supabase link` + `npx supabase db push`, remplacer par les valeurs
# du projet cloud Supabase : dashboard → Project Settings → API.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<clé « publishable » (publique) du projet cloud>

IMGBB_APIKEY="xxxxxxxxxxxxxxxxxxxxxxx"
