# ---------------------------------------------------------------------------
# eFankatia — variables d'environnement
# Copier ce fichier vers `.env` puis renseigner les valeurs.
# `.env` est gitignoré : ne jamais committer de secrets.
# ---------------------------------------------------------------------------

# --- Développement local ----------------------------------------------------
# Valeurs affichées par `npx supabase status` :
#   VITE_SUPABASE_URL      ← « Project URL »
#   VITE_SUPABASE_ANON_KEY ← « Publishable » (anciennement « anon »)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clé service role : strictement serveur (création de comptes via Admin API).
# Développement local : copier la valeur « Secret » de `npx supabase status`.
# Ne jamais la préfixer par VITE_ ni la committer.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX

# --- Seed administrateur ----------------------------------------------------
# Compte ROLE_ADMIN créé (ou mis à jour) par `npm run seed:user:admin-create`.
# Variables serveur uniquement : ne jamais les préfixer par VITE_.
# Le mot de passe doit contenir au moins 8 caractères.
ADMIN_EMAIL=admin@efankatia.local
ADMIN_PASSWORD="ChangeMe123!"

# --- Cible des seeds --------------------------------------------------------
# `local` (défaut) : base locale (`npx supabase start`).
# `linked`          : projet Supabase **cloud** lié (`npx supabase link`).
# Préférer la forme inline : elle vaut pour les deux seeds.
#   SUPABASE_DB_TARGET=linked npm run seed:personne:test
# ou les scripts dédiés : `npm run seed:personne:test:cloud`,
# `npm run seed:user:admin-create:cloud` (ce dernier lit aussi ce fichier).
# SUPABASE_DB_TARGET=local

# --- Production (Vercel) ----------------------------------------------------
# Après `npx supabase link` + `npx supabase db push`, remplacer par les valeurs
# du projet cloud Supabase : dashboard → Project Settings → API.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<clé « publishable » (publique) du projet cloud>

IMGBB_APIKEY="xxxxxxxxxxxxxxxxxxxxxxx"
